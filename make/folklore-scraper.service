[Unit]
Description=ai-folklore scraper JSON API (folklore_scraper.py serve)
# Needed so the n8n Docker container can reach this host service
# (n8n connects via host.docker.internal -> the Docker bridge gateway).
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/git-projects/ai-folklore/folklore_scraper.py serve --host 0.0.0.0 --port 8099
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
