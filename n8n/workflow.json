{
  "name": "ai-folklore — pull scraper + Gemini script",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 3"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Weekly (Wed 6AM PHT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8099/stories?limit=3",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Pull stories from scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "notes": "Scraper must be reachable from the n8n container. On the n8n host run: systemctl --user enable --now folklore-scraper.service (binds 0.0.0.0:8099). host.docker.internal resolves to the host via the compose extra_hosts entry. If it times out, allow the Docker subnet through the firewall: sudo ufw allow from 172.16.0.0/12 to any port 8099 proto tcp. n8n NOT in Docker? Use http://127.0.0.1:8099 instead."
    },
    {
      "parameters": {
        "fieldToSplitOut": "stories",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Split Out Stories",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are the scriptwriter for \\\"potaterrr\\\" 🥔, a folklore storytelling channel. Write a 60-second vertical-video narration script about the folklore story below.\\n\\nSTORY\\nTitle: {{ $json.story.title }}\\nSummary: {{ $json.story.summary }}\\nSource: {{ $json.story.url }}\\n\\nRULES\\n1. Structure: HOOK (first 3 seconds, spoken, no greetings) → the story told conversationally → a closing question to the comments.\\n2. Total 130–160 spoken words (~60 seconds at normal pace).\\n3. Stay faithful to the summary — do not invent new plot facts. Atmosphere and pacing are yours to play with.\\n4. Tone: campfire storyteller. Vivid, a little eerie, zero academic language.\\n5. Do not mention Wikipedia, sources, or that this came from anywhere.\\n6. After the narration, output one line \\\"CAPTION: ...\\\" — a 1–2 sentence Facebook Reels caption with exactly 3 hashtags (#Folklore #PhilippineMythology + one fitting the story).\\n\\nOUTPUT FORMAT\\nNARRATION:\\n<the script, plain paragraphs>\\nCAPTION: <caption line>\"\n    }]\n  }]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Gemini: write 60s script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "notes": "Create a Header Auth credential: name = x-goog-api-key, value = your Gemini API key. Free tier works."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "title",
              "value": "={{ $json.story.title }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "url",
              "value": "={{ $json.story.url }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "script",
              "value": "={{ $json.candidates[0].content.parts[0].text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Tidy fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 0]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "script",
        "options": {
          "fileName": "={{ 'folklore-' + $json.title.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '.txt' }}"
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Script to file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "channel": "=@{your-telegram-channel-id}",
        "text": "=🥔 New folklore script: {{ $('Tidy fields').item.json.title }}\n\n{{ $('Tidy fields').item.json.script }}",
        "additionalFields": {
          "attachment": "binary",
          "binaryPropertyName": "data"
        }
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1320, 0],
      "notes": "Set your channel/chat id and Telegram credential. Swap for Gmail-draft or Sheets if you prefer review-by-email."
    }
  ],
  "connections": {
    "Weekly (Wed 6AM PHT)": {
      "main": [
        [
          {
            "node": "Pull stories from scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pull stories from scraper": {
      "main": [
        [
          {
            "node": "Split Out Stories",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out Stories": {
      "main": [
        [
          {
            "node": "Gemini: write 60s script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini: write 60s script": {
      "main": [
        [
          {
            "node": "Tidy fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tidy fields": {
      "main": [
        [
          {
            "node": "Script to file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Script to file": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
